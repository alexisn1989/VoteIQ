    "patron_count": 66,
    "summary": "Increases the minimum wage incrementally to $15.00 per hour by January 1, 2028. Codifies the adjusted state hourly minimum wage of $12.77 per hour effective January 1, 2026, increases to $13.75 effective January 1, 2027, and $15.00 effective January 1, 2028. Effective January 1, 2029, and annually thereafter, requires adjustment to reflect increases in the consumer price index.",
    "provisions": {
      "A": {
        "1": "Prior to May 1, 2021, every employer shall pay to each of its employees wages at a rate not less than the federal minimum wage.",
        "2": "Beginning May 1, 2021, every employer shall pay to each of his employees at a rate not less than the federal minimum wage or 75 percent of the Virginia minimum wage provided for in this section, whichever is greater. 'Employee' means any person enrolled in an established employer on-the-job or other training program for a period not to exceed 90 days which meets standards set by the Commissioner."
      },
      "B": { "period": { "from": "January 1, 2026", "until": "January 1, 2027" }, "rate_per_hour": 12.77, "condition": "greater of state rate or federal minimum wage" },
      "C": { "period": { "from": "January 1, 2027", "until": "January 1, 2028" }, "rate_per_hour": 13.75, "condition": "greater of state rate or federal minimum wage" },
      "D": { "period": { "from": "January 1, 2028", "until": "January 1, 2029" }, "rate_per_hour": 15.00, "condition": "greater of state rate or federal minimum wage" },
      "E": { "period": { "from": "January 1, 2029", "until": null }, "rate": "adjusted state hourly minimum wage", "condition": "greater of adjusted state rate or federal minimum wage" },
      "F": {
        "annual_adjustment_deadline": "October 1 (beginning October 1, 2028)",
        "effective_date": "January 1 of the following year",
        "index": "U.S. Average Consumer Price Index for all items, all urban consumers (CPI-U)",
        "published_by": "Bureau of Labor Statistics, U.S. Department of Labor",
        "method": "Prior year state minimum wage plus CPI-U percentage increase for most recent available calendar year",
        "minimum_adjustment": 0
      }
    },
