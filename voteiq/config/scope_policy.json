  "scope_detection_rules": [
    {
      "pattern": "compare|both|state and federal|local and federal|vs\\.?|versus",
      "case_insensitive": true,
      "scope": "mixed",
      "confidence": "high",
      "explanation": "Query compares state/local and federal data"
    },
    {
      "pattern": "^(sb|hb|cr)\\s*\\d+",
      "case_insensitive": true,
      "scope": "virginia_state",
      "confidence": "high",
      "explanation": "Bill ID format (SB/HB/CR) matches Virginia General Assembly"
    },
    {
      "pattern": "u\\.s\\.\\s+(house|senate|senator|representative)|congress\\.gov|congressman|congresswoman|representative.*congress|senator.*(united states|u\\.s\\.|federal)|u\\.s\\. senator|us senator",
      "case_insensitive": true,
      "scope": "federal",
      "confidence": "high",
      "explanation": "Query mentions U.S. Congress or federal legislature"
    },
    {
      "pattern": "^(congress|what bills did congress|house voted|senate voted)",
      "case_insensitive": true,
      "scope": "federal",
      "confidence": "high",
      "explanation": "Query mentions Congress voting or legislation"
    },
    {
      "pattern": "elaine luria|elaine burke|morgan griffith|gus grisham|tim kaine|tim scott|virginia.*congressional|congressional.*virginia|virginia delegation",
      "case_insensitive": true,
      "scope": "federal",
      "confidence": "high",
      "explanation": "Query mentions Virginia congressional delegation member"
    },
    {
      "pattern": "city council|city manager|mayor|municipal government|hampton roads|virginia beach|norfolk|newport news|chesapeake|legistar|local government",
      "case_insensitive": true,
      "scope": "local_hampton_roads",
      "confidence": "high",
      "explanation": "Query mentions local government or Hampton Roads municipality"
    },
    {
      "pattern": "virginia (house|senate|general assembly|bill|law|legislature|election)",
      "case_insensitive": true,
      "scope": "virginia_state",
      "confidence": "high",
      "explanation": "Query mentions Virginia state government"
    },
    {
      "pattern": "fec|federal election commission",
      "case_insensitive": true,
      "scope": "federal",
      "confidence": "high",
      "explanation": "Query mentions FEC (Federal Election Commission)"
    }
  ],
  "routing_rules": {
    "public_record_analyst": {
      "allowed_scopes": ["local_hampton_roads", "virginia_state", "federal", "mixed"],
      "prefer_scopes": ["virginia_state", "local_hampton_roads"],
      "note": "Routes to federal specialists for federal queries"
