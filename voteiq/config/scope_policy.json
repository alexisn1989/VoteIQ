  "source_definitions": {
    "Virginia LIS": {
      "scope": "virginia_state",
      "description": "Virginia Legislative Information System",
      "current_through": "2026-05-24",
      "url": "https://lis.virginia.gov",
      "data_types": ["bills", "votes", "legislators"]
    },
    "OpenStates": {
      "scope": ["virginia_state", "federal"],
      "description": "Open States Project (state and federal legislative data)",
      "current_through": "2026-05-24",
      "url": "https://openstates.org",
      "data_types": ["bills", "votes", "legislators"]
    },
    "Virginia SBE": {
      "scope": ["virginia_state", "local_hampton_roads"],
      "description": "Virginia State Board of Elections",
      "current_through": "2026-05-24",
      "url": "https://www.elections.virginia.gov",
      "data_types": ["election_results", "voting_records"]
    },
    "VPAP": {
      "scope": ["virginia_state", "local_hampton_roads", "federal"],
      "description": "Virginia Public Access Project (campaign finance)",
      "current_through": "2026-05-23",
      "url": "https://www.vpap.org",
      "data_types": ["donations", "campaign_finance"]
    },
    "Legistar": {
      "scope": ["virginia_state", "local_hampton_roads"],
      "description": "Municipal government records (meetings, votes, agendas)",
      "current_through": "varies_by_municipality",
      "url": "https://legistar.com",
      "data_types": ["municipal_votes", "meetings", "agendas"]
    },
    "Municipal Records": {
      "scope": "local_hampton_roads",
      "description": "Direct municipal government websites and records",
      "current_through": "varies_by_municipality",
      "url": "varies",
      "data_types": ["ordinances", "resolutions", "meeting_minutes"]
    },
    "FEC": {
      "scope": "federal",
      "description": "Federal Election Commission (federal campaign finance)",
      "current_through": "2026-05-20",
      "url": "https://fec.gov",
      "data_types": ["federal_donations", "federal_committees", "federal_candidates"]
    },
    "Congress.gov": {
      "scope": "federal",
      "description": "Congress.gov (U.S. Congress bills and votes)",
      "current_through": "2026-05-24",
      "url": "https://congress.gov",
      "data_types": ["federal_bills", "federal_votes"]
    }
